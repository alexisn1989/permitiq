# Copy to .env (git-ignored) and fill in.
POSTGRES_DB=permitiq
POSTGRES_USER=permitiq
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Power BI read-only login (db/003_roles.sql). Connect Power BI as
# powerbi_reader to 127.0.0.1:5432 / permitiq and pick vw_permit_leads.
POWERBI_READER_PASSWORD=change-me-too

# Used by ingest_permits.py, scripts/load_fema_nfhl.py and the API
DATABASE_URL=postgresql://permitiq:change-me@127.0.0.1:5432/permitiq

# FiscalMapIQ (Neon) database, read by sync_fiscal_data.py (read-only use).
# The SQLAlchemy form FiscalMapIQ uses ("postgresql+psycopg://...") also works.
FISCALMAP_DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname?sslmode=require
# The city_code value FiscalMapIQ uses for Virginia Beach (required; not guessed).
# `python sync_fiscal_data.py --dry-run` lists the codes present.
FISCALMAP_CITY_CODE=

# Bearer token for POST /api/admin/ingest-permits (generate a long random one,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=

# ArcGIS field mapping, from `python ingest_permits.py --inspect`.
# Logical names: permit_number, permit_type, application_date, issue_date,
# final_date, work_desc, address. Only list the ones that differ from the
# defaults (PermitNumber, PermitType, ApplicationDate, IssueDate, FinalDate,
# WorkDesc, address=StreetAddress -- confirmed against the live VB layer's fields).
# PERMITS_FIELD_MAP=address=FullAddress

# Code enforcement field mapping, from `python ingest_violations.py --inspect`.
# There are no defaults: violation_id is required. Logical names:
# violation_id, violation_type, description, complaint_date, compliance_date, address.
# VIOLATIONS_FIELD_MAP=violation_id=...,violation_type=...,complaint_date=...,address=...

# Planning applications (rezonings, CUPs, variances) come from the GenAI
# document scraper as a local JSON file, not an API. ingest_planning.py uses
# --file, or this path when --file is omitted (POST /api/admin/ingest-planning
# relies on it). Relative paths resolve from the project root.
# PLANNING_LEADS_FILE=data/extracted_leads.json
#
# scan_planning_gemini.py writes that file from VB Planning Commission agenda
# PDFs using Gemini. Run: python scan_planning_gemini.py && python ingest_planning.py
# Leave GEMINI_API_KEY unset to reuse VoteIQ's: the scanner then reads ONLY
# GEMINI_API_KEY from ../VoteIQ/.env (or ../voteiq/.env). Point elsewhere with
# VOTEIQ_ENV_FILE. A value set here takes precedence.
# GEMINI_API_KEY=
# VOTEIQ_ENV_FILE=/path/to/VoteIQ/.env
# GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
# VIOLATIONS_LAYER_URL=https://services2.arcgis.com/CyVvlIiUfRBmMQuu/arcgis/rest/services/Code_Enforcement_Cases/FeatureServer/0
# PERMITS_LAYER_URL=https://services2.arcgis.com/CyVvlIiUfRBmMQuu/arcgis/rest/services/Building_Permits_Applications/FeatureServer/0
# NFHL_LAYER_URL=https://hazards.fema.gov/gis/nfhl/rest/services/public/NFHL/MapServer/28
# INGEST_TIMEOUT_SECONDS=900
# NOMINATIM_USER_AGENT=permitiq/0.1 (you@example.com)
